# Include inside the existing http block. Replace the upstream Host with the
# configured public_origin host. This listener is only accessible on loopback.
server {
    listen 127.0.0.1:39446;
    server_name _;
    client_max_body_size 256m;
    location /internal/ {
        proxy_pass http://127.0.0.1:32880;
        proxy_http_version 1.1;
        proxy_set_header Host 192.0.2.10;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location / { return 404; }
}
