{
  "contract_version": "0.4.0",
  "initial_states": [
    "admission_pending",
    "queued"
  ],
  "states": [
    "admission_pending",
    "queued",
    "leased",
    "preparing",
    "submitting",
    "running",
    "collecting",
    "uploading",
    "verifying",
    "reconciling",
    "retry_wait",
    "cancel_requested",
    "succeeded",
    "failed",
    "cancelled",
    "expired"
  ],
  "terminal_states": [
    "succeeded",
    "failed",
    "cancelled",
    "expired"
  ],
  "non_state_events": [
    "progress",
    "upload_progress",
    "heartbeat"
  ],
  "guards": {
    "admission_confirmed": "身份/版本/输入/额度及网关确认均已持久化。",
    "current_lease": "node/boot/attempt/fence/current_attempt/服务器租约均有效；管理动作另按角色授权。",
    "generation_slot_held": "同一物理 GPU 的 occupancy 由当前 attempt 持有，所有并发上限已检查。",
    "inputs_verified": "输入授权、ready、hash 和冻结执行环境一致。",
    "journal_intent_durable": "Worker 已持久化提交意图与可核对关联标识。",
    "comfy_acceptance_observed": "已观察原 prompt 被 ComfyUI 接收或运行，不能仅凭HTTP已发送。",
    "execution_stopped": "已确认 GPU 推理/编码停止；若从未提交则有可核对未提交证据。",
    "outputs_stable": "输出文件完整稳定、清单与媒体规格可校验。",
    "gpu_release_recorded": "GPU释放证据、occupancy删除与生成计数减少原子完成；结果租约仍保留。",
    "cloud_manifest_verified": "私有云端对象不可变版本/bytes/hash/媒体校验通过。",
    "terminal_commit_once": "终态CAS、唯一manifest、资源结算与outbox在同一事务；迟到事件不可覆盖。",
    "ownership_uncertain": "提交、租约、执行或结果归属存在不确定性；未知GPU占用继续保留。",
    "old_attempt_closed": "旧执行已结束、结果处置明确、旧结果权已失效，才能创建下一attempt。",
    "retry_budget_available": "错误分类允许重试、deadline/次数/规格预算均允许，不重新扣accepted计数。",
    "not_running_proven": "没有活动GPU计算/提交未知，不能以超时或空history作为唯一证据。",
    "deadline_reached": "服务器确认冻结总预算或排队截止已到。",
    "cancel_authorized": "操作主体有权取消，取消意图已持久化。",
    "no_result_publish": "撤销后不发布客户结果，按规则释放预留并保留历史。",
    "resume_authorized": "恢复证据已审查、resume_state匹配、新boot/fence结果权已正式授予；不是旧租约复活。",
    "safe_failure": "错误不可恢复且已证明无继续执行/未知占用；资源与产物处置明确。",
    "resources_accounted": "当前事务按已确认资源事实结算/释放占用与计数、处置结果权和预留；不得仅改状态遗留槽位或负数计数。未知执行不能通过此guard。"
  },
  "transitions": [
    {
      "from": "admission_pending",
      "to": "queued",
      "trigger": "confirm_admission",
      "guards": [
        "admission_confirmed"
      ]
    },
    {
      "from": "admission_pending",
      "to": "failed",
      "trigger": "reject_admission",
      "guards": [
        "safe_failure",
        "terminal_commit_once",
        "resources_accounted"
      ]
    },
    {
      "from": "admission_pending",
      "to": "cancelled",
      "trigger": "abort_admission",
      "guards": [
        "cancel_authorized",
        "no_result_publish",
        "terminal_commit_once",
        "resources_accounted"
      ]
    },
    {
      "from": "admission_pending",
      "to": "expired",
      "trigger": "admission_timeout",
      "guards": [
        "deadline_reached",
        "not_running_proven",
        "terminal_commit_once",
        "resources_accounted"
      ]
    },
    {
