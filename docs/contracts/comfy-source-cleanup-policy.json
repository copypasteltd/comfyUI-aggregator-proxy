{
  "contract_version": "0.4.0",
  "format_version": 1,
  "protocol": "comfy-source-cleanup-v1",
  "increment": 121,
  "status": "design_only",
  "implemented": false,
  "deployed": false,
  "requirement": "Request deletion of ComfyUI original files immediately after complete verified durable handoff to Worker spool, without waiting for cloud upload.",
  "documentation": "docs/121-ComfyUI原始产物移交即清理设计.md",
  "existing_requirement": "DATA-08",
  "trigger": {
    "first_attempt": "wake_after_package_and_cleanup_intent_commit",
    "requires_cloud_upload": false,
    "requires_cloud_complete": false,
    "requires_cloud_outputs_collected_ack": false,
    "guards": [
      "original_prompt_success_and_absent_from_running_and_pending",
      "encoding_stopped_and_final_files_stable",
      "complete_frozen_output_count",
      "all_spool_files_fsynced_and_reread_sha256_and_size_verified",
      "package_and_source_cleanup_outbox_committed_in_one_full_sync_transaction",
      "all_recovery_branches_can_use_spool_without_originals",
      "exact_attempt_and_installation_ownership",
      "safe_source_and_spool_handles_and_content_rechecked_before_deletion"
    ]
  },
  "proposed_comfy_routes": [
    {"method": "GET", "path": "/render-control/v1/source-cleanup/capabilities"},
    {"method": "POST", "path": "/render-control/v1/source-cleanups", "accepted_status": 202},
    {"method": "GET", "path": "/render-control/v1/source-cleanups/{cleanup_id}"}
  ],
  "transport": {
    "peer": "actual_loopback_only",
    "authentication": "dedicated_local_hmac_sha256",
    "signature_fields": ["method", "path", "unix_seconds", "request_uuid", "sha256_raw_body"],
    "signature_separator": "\n",
    "max_clock_skew_seconds": 120,
    "idempotency_key": "cleanup_id",
    "same_key_different_body": "reject",
    "redirects": false,
    "environment_proxy": false,
    "connect_timeout_seconds": 2,
    "http_timeout_seconds": 10,
    "minimum_poll_seconds": 5
  },
  "file_scope": {
    "source_roots": ["output/render-control/{attempt_id}", "temp/render-control/{attempt_id}"],
    "spool_root": "configured_worker_state_root/outputs/{attempt_id}",
    "finals": "all_final_adapter_files_after_complete_package_handoff",
    "intermediates": "only_frozen_declared_cache_roles_with_exact_execution_ownership_and_no_remaining_references",
    "unknown_files": "retain_and_report_uncovered",
    "historical_discovery_deletion": false,
    "recursive_directory_deletion": false,
    "reparse_points_or_multiple_hardlinks": "reject",
    "delete_replaced_or_changed_identity": false,
    "delete_history": false,
    "unload_models_or_free_global_memory": false,
    "delete_inputs_models_workflows_or_other_attempts": false
  },
  "durability": {
    "worker": "additive_source_cleanup_outbox_same_transaction_as_output_packages",
    "comfy_extension": "bounded_private_journal_with_per_file_intent_and_receipt",
    "recovery": "validate_persisted_spool_then_replay_original_events_without_collecting_deleted_sources",
    "pending_cleanup_without_valid_spool": "block_new_deletion_preserve_existing_source",
    "no_implicit_regeneration": true,
    "no_business_success_rollback_on_cleanup_failure": true,
    "terminal_idempotency_minimum_days": 30,
    "expired_request": "never_start_new_deletion"
  },
  "states": ["pending", "accepted", "deleting", "retry_wait", "blocked", "deleted"],
  "file_results": ["pending", "delete_pending", "deleted", "already_absent", "retry_wait", "blocked"],
  "limits": {
    "fallback_scan_seconds": 15,
    "scan_maximum_intents": 20,
    "scheduling_budget_seconds": 5,
    "maximum_body_bytes": 131072,
    "maximum_files": 64,
    "maximum_package_bytes": 8589934592,
    "maximum_image_bytes": 33554432,
    "maximum_video_or_audio_bytes": 2147483648,
    "frozen_release_limit_also_applies": true,
    "concurrent_disk_operations_per_comfy": 1,
    "maximum_queued_requests": 128,
    "hash_block_bytes": 1048576,
    "maximum_file_seconds": 300,
    "maximum_package_seconds": 600,
    "maximum_active_journal_records": 10000,
    "maximum_journal_bytes": 268435456,
    "retry_delay_seconds": [10, 60, 300, 1800],
    "retry_maximum_delay_seconds": 1800,
    "retry_jitter_fraction": 0.2,
    "maximum_failures": 24,
    "maximum_retry_age_seconds": 86400
  },
  "other_retention": {
    "worker_spool_minimum_after_cloud_ack_seconds": 3600,
    "unacknowledged_spool": "never_automatically_delete",
    "cloud_output_after_success_seconds": 28800,
    "client_download": "client_managed"
  },
  "development_items": ["SRC-01", "SRC-02", "SRC-03", "SRC-04", "SRC-05", "SRC-06", "SRC-07", "SRC-08"],
  "acceptance_groups": ["SC-01", "SC-02", "SC-03", "SC-04", "SC-05", "SC-06", "SC-07", "SC-08", "SC-09", "SC-10"],
  "runtime_acceptance": "not_run",
  "production_deletion_performed_by_this_increment": false
}
