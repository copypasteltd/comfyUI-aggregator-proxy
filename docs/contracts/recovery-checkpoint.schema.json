{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:render-control:recovery-checkpoint:0.5.0",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 1,
      "type": "integer"
    },
    "contract_version": {
      "const": "0.5.0"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "database_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "hmac_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "rows",
          "hmac_sha256"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "object",
      "properties": {
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "media": {
          "type": "object",
          "properties": {
            "images": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "videos": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "audio": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "other": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "images",
            "videos",
            "audio",
            "other"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "records",
        "bytes",
        "media"
      ],
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "master_canary": {
          "type": "string",
          "minLength": 80,
          "maxLength": 512
        },
        "pepper_canary": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pepper_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "encrypted_values": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "master_canary",
        "pepper_canary",
        "pepper_version",
        "encrypted_values"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format_version",
    "contract_version",
    "created_at_ms",
    "nonce",
    "database_revision",
    "tables",
    "objects",
    "secrets",
    "signature"
  ],
  "additionalProperties": false
}
