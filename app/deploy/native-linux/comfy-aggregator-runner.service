[Unit]
Description=ComfyUI Aggregator Lease Maintenance
After=network-online.target comfy-aggregator-postgres.service
Requires=comfy-aggregator-postgres.service

[Service]
Type=simple
User=comfy-runner
Group=comfy-control
WorkingDirectory=/var/lib/comfyui-aggregator/runner
EnvironmentFile=/etc/comfyui-aggregator/cloud.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/comfyui-aggregator/current/venv/bin/python -m control_runner.main
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/comfyui-aggregator/runner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=96M
MemoryMax=160M
TasksMax=32

[Install]
WantedBy=multi-user.target
