{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway-catalog-replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "expected_revision",
    "source_revision"
  ],
  "properties": {
    "action": {
      "enum": [
        "retry",
        "rollback"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  }
}
