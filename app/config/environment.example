GEN_ENVIRONMENT=production
GEN_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/render_control
GEN_CREDENTIAL_PEPPER=REPLACE_WITH_AT_LEAST_43_RANDOM_CHARACTERS
GEN_CREDENTIAL_PEPPER_VERSION=1
GEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
GEN_PUBLIC_ORIGIN=https://render.example.invalid
GEN_SESSION_SECONDS=28800
GEN_SESSION_IDLE_SECONDS=1800
GEN_STORAGE_BACKEND=s3
GEN_S3_ENDPOINT=https://private-storage.example.invalid
GEN_S3_BUCKET=render-private
GEN_S3_REGION=us-east-1
GEN_S3_ACCESS_KEY=REPLACE_ME
GEN_S3_SECRET_KEY=REPLACE_ME
GEN_SPOOL_ROOT=.local/spool
GEN_ADMIN_DIST=apps/admin_web/dist
GEN_ACCESS_LOG_RETENTION_DAYS=30
# Set an explicitly approved audit retention period to enable automatic pruning.
# GEN_AUDIT_RETENTION_DAYS=180
# Dedicated read-only monitoring identity; disabled until hashes are configured.
GEN_MONITORING_TOKEN_SHA256=[]
GEN_MONITORING_ALLOWED_NETWORKS=["127.0.0.1/32","::1/128"]
