{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Admin alert query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "gpu_occupancy_uncertain",
            "job_reconciling",
            "node_heartbeat_stale",
            "channel_observation_stale",
            "channel_config_unverified",
            "job_waiting_over_5m",
            "operation_failed",
            "gateway_settlement_unacked",
            "worker_storage_pressure",
            "worker_memory_pressure",
            "worker_upload_backlog",
            "worker_capacity_unavailable",
            "spec_isolation",
            "job_oom_recent",
            "job_output_invalid_recent"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "critical",
            "warning"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:gpu|job|node|ch|op|evt|iso)_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
