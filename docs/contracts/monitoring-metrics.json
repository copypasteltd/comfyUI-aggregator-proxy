      "kind"
    ],
    "outbox_oldest_seconds": [
      "kind"
    ],
    "objects_pending_delete": [],
    "objects_pending_delete_bytes": [],
    "objects_pending_delete_oldest_seconds": [],
    "pg_connections": [
      "state"
    ],
    "pg_lock_waits": [],
    "jobs_age_unknown": [
      "state",
      "kind"
    ]
  },
  "http_operation_groups": [
    "health",
    "admin_read",
    "admin_write",
    "business_read",
    "business_write",
    "gateway_read",
    "gateway_write",
    "worker_read",
    "worker_write",
    "monitoring",
    "admin_static",
    "other"
  ],
  "http_histogram_buckets_seconds": [
    0.005,
    0.01,
    0.025,
    0.05,
    0.1,
    0.25,
    0.5,
    1,
    2.5,
    5,
    15,
    60,
    300,
    3600
