# Replace PUBLIC_HOST before installing; do not include this in another nginx master.
worker_processes 1;
pid /var/lib/comfyui-aggregator/edge/nginx.pid;
error_log stderr warn;
events { worker_connections 128; }
http {
    access_log off;
    default_type application/octet-stream;
    server_tokens off;
    client_body_temp_path /var/lib/comfyui-aggregator/edge/client-body;
    proxy_temp_path /var/lib/comfyui-aggregator/edge/proxy;
    fastcgi_temp_path /var/lib/comfyui-aggregator/edge/fastcgi;
    uwsgi_temp_path /var/lib/comfyui-aggregator/edge/uwsgi;
    scgi_temp_path /var/lib/comfyui-aggregator/edge/scgi;
    client_max_body_size 128m;
    client_body_timeout 60s;
    send_timeout 300s;
    server {
        listen 39443;
        server_name PUBLIC_HOST;
        location = / { return 302 /admin/; }
        location = /internal { return 404; }
        location ^~ /internal/ { return 404; }
        location / {
            proxy_pass http://127.0.0.1:32880;
            proxy_http_version 1.1;
            proxy_set_header Host PUBLIC_HOST;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto http;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }
}
