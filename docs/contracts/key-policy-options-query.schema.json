{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:render-control:key-policy-options-query:0.4.0",
  "title": "Key content policy directory query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "kind",
    "tenant_id"
  ],
  "properties": {
    "mode": {
      "enum": [
        "browse",
        "resolve"
      ]
    },
    "kind": {
      "enum": [
        "project",
        "creator_key"
      ]
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "q": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "project_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^prj_[0-9a-f]{32}$"
      }
    },
    "ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "project"
          }
        }
      },
      "then": {
        "properties": {
          "project_ids": {
            "maxItems": 0
          },
          "ids": {
            "items": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{32}$"
            }
          }
        }
      },
      "else": {
        "properties": {
          "ids": {
            "items": {
              "type": "string",
              "pattern": "^key_[0-9a-f]{32}$"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "browse"
          }
        }
      },
      "then": {
        "properties": {
          "ids": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "minItems": 1
          },
          "page": {
            "const": 1
          },
          "q": {
            "maxLength": 0
          }
        }
      }
    }
  ]
}
