    ],
    "jobs_recent": [
      "outcome",
      "task_type",
      "kind"
    ],
    "job_failures_recent": [
      "error_class",
      "task_type",
      "kind"
    ],
    "job_duration_seconds": [
      "task_type",
      "kind",
      "quantile"
    ],
    "job_duration_observations": [
      "task_type",
      "kind"
    ],
    "gpu_resources": [
      "status"
    ],
    "gpu_occupancy": [
      "status"
    ],
    "nodes": [
      "status"
    ],
    "node_heartbeat_oldest_seconds": [],
    "channels": [
      "status"
    ],
    "spec_isolations": [],
