{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway-catalog-stamp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "revision",
    "digest"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
