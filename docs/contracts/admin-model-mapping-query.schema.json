{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generation.local/contracts/admin-model-mapping-query.schema.json",
  "title": "admin-model-mapping-query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "workflow",
        "release",
        "channel",
        "preset"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-f0-9]{32}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "q": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
          "not": {
            "pattern": "[\u0000-\u001f-]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wf_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wfr_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^mdl_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "task_type": {
      "anyOf": [
        {
          "enum": [
            "text_to_image",
            "image_to_image",
            "references_to_image",
            "text_to_video",
            "references_to_video",
            "text_to_audio",
            "image_to_3d"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "project_id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow"
          }
        }
      },
      "then": {
        "properties": {
          "workflow_id": {
            "type": "null"
          },
          "release_id": {
            "type": "null"
          },
          "model_id": {
            "type": "null"
          },
          "ids": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^wf_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\\r\\n]"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "release"
          }
        }
      },
      "then": {
        "properties": {
          "release_id": {
            "type": "null"
          },
          "model_id": {
            "type": "null"
          },
          "ids": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^wfr_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\\r\\n]"
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "workflow_id"
            ],
            "properties": {
              "workflow_id": {
                "type": "string",
                "pattern": "^wf_[a-f0-9]{32}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              }
            }
          },
          {
            "required": [
              "ids"
            ],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "channel"
          }
        }
      },
      "then": {
        "properties": {
          "workflow_id": {
            "type": "null"
          },
          "release_id": {
            "type": "null"
          },
          "task_type": {
            "type": "null"
          },
          "ids": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ch_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\\r\\n]"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "preset"
          }
        }
      },
      "then": {
        "properties": {
          "workflow_id": {
            "type": "null"
          },
          "model_id": {
            "type": "null"
          },
          "task_type": {
            "type": "null"
          },
          "q": {
            "type": "null"
          },
          "ids": {
            "type": "array",
            "maxItems": 0,
            "uniqueItems": true,
            "items": {}
          },
          "release_id": {
            "type": "string",
            "pattern": "^wfr_[a-f0-9]{32}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        },
        "required": [
          "release_id"
        ]
      }
    },
    {
      "if": {
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "page": {
            "const": 1
          }
        }
      }
    }
  ]
}
