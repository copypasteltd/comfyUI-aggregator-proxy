{
  "schema_version": "1.0",
  "display_name": "YuE2 · 音乐生成 · RTX 3080",
  "description": "通过已验证 ComfyUI Workflow 生成音乐生成产物。输入和输出规格以本模型 usage 中冻结的参数、参考槽位与 preset 组合为准；提交后返回任务 ID，可异步查询并下载。",
  "notes": [
    "仅接受公布的 preset 组合，不支持任意指定分辨率或时长。",
    "生成结果从成功开始保留 8 小时；请使用同一业务 Key 查询和下载。",
    "此模型不接受参考图输入。",
    "prompt 对应音乐风格 style。歌词和其他乐谱输入来自冻结工作流，本模型尚未公开歌词编辑、TTS 或音色克隆参数。"
  ],
  "tags": [
    "text_to_audio",
    "YuE2",
    "asynchronous"
  ],
  "task_type": "text_to_audio",
  "asynchronous": true,
  "endpoints": {
    "create": "/v1/jobs",
    "poll": "/v1/jobs/{job_id}",
    "upload": "/v1/assets",
    "content": "/v1/content/{content_id}",
    "download": "/v1/content/{content_id}/download"
  },
  "request_content_type": "application/json",
  "required_scopes": [
    "models:read",
    "capabilities:read",
    "jobs:create",
    "audio:create",
    "jobs:read",
    "artifacts:read",
    "content:read",
    "content:download"
  ],
  "defaults": {
    "n": 1,
    "quality": "standard",
    "seconds": 30.0
  },
  "parameter_details": [
    {
      "path": "input.prompt",
      "required": true,
      "description": "必填文字提示；音乐/音频使用该模型说明约定的文本格式。",
      "rules": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    },
    {
      "path": "parameters.quality",
      "required": false,
      "description": "质量档位；必须与尺寸/时长匹配同一条已发布 preset。",
      "rules": {
        "enum": [
          "standard",
          "draft"
        ],
        "default": "standard"
      }
    },
    {
      "path": "parameters.seed",
      "required": false,
      "description": "随机种子；省略由服务固定生成，幂等重放保持同一生成请求。",
      "rules": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    {
      "path": "parameters.n",
      "required": false,
      "description": "每次任务的主产物数量，目前固定为 1。",
      "rules": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1,
        "default": 1
      }
    },
    {
      "path": "parameters.seconds",
      "required": false,
      "description": "预设的生成时长，单位秒；不能指定 presets 以外的时长。",
      "rules": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600,
        "multipleOf": 0.001,
        "default": 30.0,
        "enum": [
          30.0,
          15.0
        ]
      }
    }
  ],
  "references": {
    "supported": false,
    "exact_reference_count": 0,
    "slots": [],
    "media_types": [],
    "max_upload_bytes": 20971520,
    "max_image_pixels": 25000000,
    "upload_field": "file",
    "asset_scope": "same_api_key",
    "note": "上传静态图片获得 asset_id；与生成使用同一个业务 Key。参考数组必须完整且有序，不能传图片 URL、本地路径或视频文件。"
  },
  "input_slots": [],
  "text_slots": [],
  "context": null,
  "presets": [
    {
      "quality": "standard",
      "seconds": 30.0,
      "audio_format": "flac",
      "sample_rate": 48000,
      "channels": 2
    },
    {
      "quality": "draft",
      "seconds": 15.0,
      "audio_format": "flac",
      "sample_rate": 48000,
      "channels": 2
    }
  ],
  "output": {
    "media_types": [
      "audio/flac"
    ],
    "expected_count": 1,
    "max_bytes": 134217728,
    "audio_policy": null
  },
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "comfy-3080-music-yue2 generation request",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "task_type",
      "input"
    ],
    "properties": {
      "model": {
        "const": "comfy-3080-music-yue2"
      },
      "task_type": {
        "const": "text_to_audio"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        }
      },
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quality": {
            "enum": [
              "standard",
              "draft"
            ],
            "default": "standard"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1,
            "default": 1
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600,
            "multipleOf": 0.001,
            "default": 30.0,
            "enum": [
              30.0,
              15.0
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "quality": {
                "const": "standard"
              },
              "seconds": {
                "const": 30.0
              }
            }
          },
          {
            "properties": {
              "quality": {
                "const": "draft"
              },
              "seconds": {
                "const": 15.0
              }
            },
            "required": [
              "quality",
              "seconds"
            ]
          }
        ]
      },
      "client_request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "image_to_3d"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "prompt"
                    ]
                  },
                  {
                    "required": [
                      "negative_prompt"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  },
                  {
                    "required": [
                      "references"
                    ]
                  }
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "source_image"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            },
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "size"
                    ]
                  },
                  {
                    "required": [
                      "seconds"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  },
                  {
                    "required": [
                      "strength"
                    ]
                  }
                ]
              }
            }
          }
        },
        "else": {
          "properties": {
            "input": {
              "anyOf": [
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_image",
                "text_to_video",
                "text_to_audio"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source_image"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  },
                  {
                    "required": [
                      "references"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "image_to_image"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "required": [
                  "references"
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "source_image"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "references_to_image",
                "references_to_video"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source_image"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  }
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "references"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_image",
                "image_to_image",
                "references_to_image"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "seconds"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_video",
                "references_to_video"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "properties": {
                "n": {
                  "const": 1
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "not": {
                "const": "image_to_image"
              }
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "required": [
                  "strength"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "references_to_image"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "properties": {
                "references": {
                  "minItems": 2
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "references_to_video"
            },
            "input": {
              "properties": {
                "references": {
                  "maxItems": 1
                }
              },
              "required": [
                "references"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "properties": {
                "references": {
                  "items": {
                    "properties": {
                      "role": {
                        "const": "first_frame"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "text_to_audio"
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "size"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  }
                ]
              }
            }
          }
        },
        "else": {
          "properties": {
            "parameters": {
              "properties": {
                "seconds": {
                  "maximum": 120
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "not": {
                "enum": [
                  "text_to_video",
                  "references_to_video"
                ]
              }
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "required": [
                  "context"
                ]
              }
            }
          }
        }
      }
    ],
    "$defs": {
      "assetId": {
        "type": "string",
        "pattern": "^asset_[A-Za-z0-9_-]{6,80}$"
      },
      "asset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id"
        ],
        "properties": {
          "asset_id": {
            "$ref": "#/$defs/assetId"
          }
        }
      }
    }
  },
  "example_request": {
    "model": "comfy-3080-music-yue2",
    "task_type": "text_to_audio",
    "input": {
      "prompt": "Gentle chamber music with warm acoustic strings and a soft piano melody, calm atmosphere, natural dynamics."
    },
    "parameters": {
      "n": 1,
      "quality": "standard",
      "seconds": 30.0,
      "seed": 42
    }
  },
  "output_retention_seconds": 28800,
  "availability_note": "目录表示当前 Key 可发现的已发布能力；设备在线状态、当前容量、额度及提交准入仍需实时检查。"
}
