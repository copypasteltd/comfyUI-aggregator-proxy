{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gateway-catalog-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "revision",
    "digest",
    "status"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "applied",
        "rejected"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unsupported_configuration",
        "account_unavailable",
        "group_unavailable",
        "storage_unavailable",
        "apply_failed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "applied"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "error_code"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          }
        }
      }
    }
  ]
}
