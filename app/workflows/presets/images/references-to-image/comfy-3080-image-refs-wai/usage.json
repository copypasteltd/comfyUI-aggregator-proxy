{
  "schema_version": "1.0",
  "display_name": "WAI · 双参考图生图 · RTX 3080",
  "description": "通过已验证 ComfyUI Workflow 生成双参考图生图产物。输入和输出规格以本模型 usage 中冻结的参数、参考槽位与 preset 组合为准；提交后返回任务 ID，可异步查询并下载。",
  "notes": [
    "仅接受公布的 preset 组合，不支持任意指定分辨率或时长。",
    "生成结果从成功开始保留 8 小时；请使用同一业务 Key 查询和下载。",
    "参考图按声明的位置和数量传入，须先通过 /v1/assets 上传。"
  ],
  "tags": [
    "references_to_image",
    "WAI",
    "asynchronous"
  ],
  "task_type": "references_to_image",
  "asynchronous": true,
  "endpoints": {
    "create": "/v1/jobs",
    "poll": "/v1/jobs/{job_id}",
    "upload": "/v1/assets",
    "content": "/v1/content/{content_id}",
    "download": "/v1/content/{content_id}/download"
  },
  "request_content_type": "application/json",
  "required_scopes": [
    "models:read",
    "capabilities:read",
    "jobs:create",
    "images:create",
    "jobs:read",
    "artifacts:read",
    "content:read",
    "content:download",
    "assets:upload"
  ],
  "defaults": {
    "n": 1,
    "size": "720x1080",
    "quality": "standard"
  },
  "parameter_details": [
    {
      "path": "input.prompt",
      "required": true,
      "description": "必填文字提示；音乐/音频使用该模型说明约定的文本格式。",
      "rules": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    },
    {
      "path": "input.negative_prompt",
      "required": false,
      "description": "反向提示词；仅在本模型声明支持时传入 input。",
      "rules": {
        "type": "string",
        "maxLength": 8000
      }
    },
    {
      "path": "parameters.size",
      "required": false,
      "description": "宽x高，例如 720x1080；只能选择 presets 中完整的规格组合。",
      "rules": {
        "type": "string",
        "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$",
        "default": "720x1080",
        "enum": [
          "720x1080"
        ]
      }
    },
    {
      "path": "parameters.quality",
      "required": false,
      "description": "质量档位；必须与尺寸/时长匹配同一条已发布 preset。",
      "rules": {
        "enum": [
          "standard"
        ],
        "default": "standard"
      }
    },
    {
      "path": "parameters.seed",
      "required": false,
      "description": "随机种子；省略由服务固定生成，幂等重放保持同一生成请求。",
      "rules": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    {
      "path": "parameters.n",
      "required": false,
      "description": "每次任务的主产物数量，目前固定为 1。",
      "rules": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1,
        "default": 1
      }
    }
  ],
  "references": {
    "supported": true,
    "exact_reference_count": 2,
    "slots": [
      {
        "path": "input.references[0]",
        "required": true,
        "description": "第 1 张参考图，数组顺序与 Workflow 槽位一致；role 为语义标签，不改变槽位顺序。",
        "weight_supported": false
      },
      {
        "path": "input.references[1]",
        "required": true,
        "description": "第 2 张参考图，数组顺序与 Workflow 槽位一致；role 为语义标签，不改变槽位顺序。",
        "weight_supported": false
      }
    ],
    "media_types": [
      "image/png",
      "image/jpeg",
      "image/webp"
    ],
    "max_upload_bytes": 20971520,
    "max_image_pixels": 25000000,
    "upload_field": "file",
    "asset_scope": "same_api_key",
    "note": "上传静态图片获得 asset_id；与生成使用同一个业务 Key。参考数组必须完整且有序，不能传图片 URL、本地路径或视频文件。"
  },
  "input_slots": [],
  "text_slots": [],
  "context": null,
  "presets": [
    {
      "quality": "standard",
      "size": "720x1080"
    }
  ],
  "output": {
    "media_types": [
      "image/png"
    ],
    "expected_count": 1,
    "max_bytes": 33554432,
    "audio_policy": null
  },
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "comfy-3080-image-refs-wai generation request",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "task_type",
      "input"
    ],
    "properties": {
      "model": {
        "const": "comfy-3080-image-refs-wai"
      },
      "task_type": {
        "const": "references_to_image"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "references"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "negative_prompt": {
            "type": "string",
            "maxLength": 8000
          },
          "references": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "role"
                ],
                "properties": {
                  "asset_id": {
                    "$ref": "#/$defs/assetId"
                  },
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "asset_id",
                  "role"
                ],
                "properties": {
                  "asset_id": {
                    "$ref": "#/$defs/assetId"
                  },
                  "role": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                  }
                }
              }
            ],
            "items": false
          }
        }
      },
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$",
            "default": "720x1080",
            "enum": [
              "720x1080"
            ]
          },
          "quality": {
            "enum": [
              "standard"
            ],
            "default": "standard"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1,
            "default": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "quality": {
                "const": "standard"
              },
              "size": {
                "const": "720x1080"
              }
            }
          }
        ]
      },
      "client_request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "image_to_3d"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "prompt"
                    ]
                  },
                  {
                    "required": [
                      "negative_prompt"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  },
                  {
                    "required": [
                      "references"
                    ]
                  }
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "source_image"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            },
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "size"
                    ]
                  },
                  {
                    "required": [
                      "seconds"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  },
                  {
                    "required": [
                      "strength"
                    ]
                  }
                ]
              }
            }
          }
        },
        "else": {
          "properties": {
            "input": {
              "anyOf": [
                {
                  "required": [
                    "prompt"
                  ]
                },
                {
                  "required": [
                    "texts"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_image",
                "text_to_video",
                "text_to_audio"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source_image"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  },
                  {
                    "required": [
                      "references"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "image_to_image"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "required": [
                  "references"
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "source_image"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "references_to_image",
                "references_to_video"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "source_image"
                    ]
                  },
                  {
                    "required": [
                      "mask"
                    ]
                  }
                ]
              },
              "anyOf": [
                {
                  "required": [
                    "references"
                  ]
                },
                {
                  "required": [
                    "media"
                  ]
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_image",
                "image_to_image",
                "references_to_image"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "seconds"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "enum": [
                "text_to_video",
                "references_to_video"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "properties": {
                "n": {
                  "const": 1
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "not": {
                "const": "image_to_image"
              }
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "required": [
                  "strength"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "references_to_image"
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "properties": {
                "references": {
                  "minItems": 2
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "references_to_video"
            },
            "input": {
              "properties": {
                "references": {
                  "maxItems": 1
                }
              },
              "required": [
                "references"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "properties": {
                "references": {
                  "items": {
                    "properties": {
                      "role": {
                        "const": "first_frame"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "const": "text_to_audio"
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "size"
                    ]
                  },
                  {
                    "required": [
                      "fps"
                    ]
                  }
                ]
              }
            }
          }
        },
        "else": {
          "properties": {
            "parameters": {
              "properties": {
                "seconds": {
                  "maximum": 120
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "task_type": {
              "not": {
                "enum": [
                  "text_to_video",
                  "references_to_video"
                ]
              }
            }
          }
        },
        "then": {
          "properties": {
            "input": {
              "not": {
                "required": [
                  "context"
                ]
              }
            }
          }
        }
      }
    ],
    "$defs": {
      "assetId": {
        "type": "string",
        "pattern": "^asset_[A-Za-z0-9_-]{6,80}$"
      },
      "asset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id"
        ],
        "properties": {
          "asset_id": {
            "$ref": "#/$defs/assetId"
          }
        }
      }
    }
  },
  "example_request": {
    "model": "comfy-3080-image-refs-wai",
    "task_type": "references_to_image",
    "input": {
      "prompt": "A green lime beside a white ceramic cup on a wooden table, soft daylight, fixed camera, clean background, subtle natural motion, no text.",
      "references": [
        {
          "asset_id": "asset_REPLACE_WITH_UPLOADED_ID_1",
          "role": "reference_0"
        },
        {
          "asset_id": "asset_REPLACE_WITH_UPLOADED_ID_2",
          "role": "reference_1"
        }
      ]
    },
    "parameters": {
      "n": 1,
      "size": "720x1080",
      "quality": "standard",
      "seed": 42
    }
  },
  "output_retention_seconds": 28800,
  "availability_note": "目录表示当前 Key 可发现的已发布能力；设备在线状态、当前容量、额度及提交准入仍需实时检查。"
}
