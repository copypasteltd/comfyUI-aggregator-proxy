{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generation.local/contracts/key-generation-options-query.schema.json",
  "title": "key-generation-options-query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "models",
        "workflow_releases",
        "channels"
      ]
    },
    "mode": {
      "enum": [
        "browse",
        "resolve"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-f0-9]{32}$",
      "not": {
        "pattern": "[\r\n]"
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 1
    },
    "q": {
      "type": "string",
      "maxLength": 128,
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$"
        }
      ],
      "default": "",
      "not": {
        "pattern": "[\u0000-\u001f-]"
      }
    },
    "ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "not": {
          "pattern": "[\u0000-\u001f-]"
        }
      },
      "default": []
    }
  },
  "required": [
    "kind",
    "mode",
    "project_id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "browse"
          }
        }
      },
      "then": {
        "properties": {
          "ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "resolve"
          }
        }
      },
      "then": {
        "properties": {
          "page": {
            "const": 1
          },
          "q": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workflow_releases"
          }
        }
      },
      "then": {
        "properties": {
          "ids": {
            "items": {
              "type": "string",
              "pattern": "^wfr_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\r\n]"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "channels"
          }
        }
      },
      "then": {
        "properties": {
          "ids": {
            "items": {
              "type": "string",
              "pattern": "^ch_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\r\n]"
              }
            }
          }
        }
      }
    }
  ]
}
