{
  "id": "comfy-3080-3d-trellis2",
  "object": "model",
  "created": 1793233088,
  "owned_by": "render-control",
  "usage": {
    "schema_version": "1.0",
    "display_name": "TRELLIS2 · 单图生成 3D · RTX 3080",
    "description": "使用同一 API Key 上传的主体图片，经 TRELLIS2 生成一个自包含静态三角网格 GLB 2.0。异步提交、查询并下载；不接受文字提示或输出尺寸参数。",
    "notes": [
      "仅支持冻结的 standard 预设，seed 可传；n 固定为 1。",
      "实际文件元数据提供网格、顶点、三角面及材质计数；这些计数不代表拓扑或打印质量验收。",
      "GLB 可能包含顶点颜色；不承诺 UV/PBR 贴图、动画、骨骼或可打印性。",
      "需要 meshes:create 以及 Tenant、Project、Key 三层 3D 配额。",
      "云端结果成功后保留 8 小时，请及时鉴权下载。"
    ],
    "tags": [
      "image_to_3d",
      "TRELLIS2",
      "GLB",
      "asynchronous"
    ],
    "task_type": "image_to_3d",
    "asynchronous": true,
    "endpoints": {
      "create": "/v1/jobs",
      "poll": "/v1/jobs/{job_id}",
      "upload": "/v1/assets",
      "content": "/v1/content/{content_id}",
      "download": "/v1/content/{content_id}/download"
    },
    "request_content_type": "application/json",
    "required_scopes": [
      "models:read",
      "capabilities:read",
      "jobs:create",
      "meshes:create",
      "jobs:read",
      "artifacts:read",
      "content:read",
      "content:download",
      "assets:upload"
    ],
    "defaults": {
      "n": 1,
      "quality": "standard"
    },
    "parameter_details": [
      {
        "path": "parameters.quality",
        "required": false,
        "description": "质量档位；必须与尺寸/时长匹配同一条已发布 preset。",
        "rules": {
          "enum": [
            "standard"
          ],
          "default": "standard"
        }
      },
      {
        "path": "parameters.seed",
        "required": false,
        "description": "随机种子；省略由服务固定生成，幂等重放保持同一生成请求。",
        "rules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      {
        "path": "parameters.n",
        "required": false,
        "description": "每次任务的主产物数量，目前固定为 1。",
        "rules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "default": 1
        }
      }
    ],
    "references": {
      "supported": true,
      "exact_reference_count": 0,
      "slots": [
        {
          "path": "input.source_image",
          "required": true,
          "description": "生成依据的源图片；先上传并使用返回的 asset_id。",
          "weight_supported": false
        }
      ],
      "media_types": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "max_upload_bytes": 20971520,
      "max_image_pixels": 25000000,
      "upload_field": "file",
      "asset_scope": "same_api_key",
      "note": "上传静态图片获得 asset_id；与生成使用同一个业务 Key。参考数组必须完整且有序，不能传图片 URL、本地路径或视频文件。"
    },
    "presets": [
      {
        "quality": "standard"
      }
    ],
    "output": {
      "media_types": [
        "model/gltf-binary"
      ],
      "expected_count": 1,
      "max_bytes": 536870912
    },
    "request_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "comfy-3080-3d-trellis2 generation request",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "task_type",
        "input"
      ],
      "properties": {
        "model": {
          "const": "comfy-3080-3d-trellis2"
        },
        "task_type": {
          "const": "image_to_3d"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_image"
          ],
          "properties": {
            "source_image": {
              "$ref": "#/$defs/asset"
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": {
              "enum": [
                "standard"
              ],
              "default": "standard"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1,
              "default": 1
            }
          },
          "anyOf": [
            {
              "properties": {
                "quality": {
                  "const": "standard"
                }
              }
            }
          ]
        },
        "client_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "image_to_3d"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "required": [
                  "source_image"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "prompt"
                      ]
                    },
                    {
                      "required": [
                        "negative_prompt"
                      ]
                    },
                    {
                      "required": [
                        "mask"
                      ]
                    },
                    {
                      "required": [
                        "references"
                      ]
                    }
                  ]
                }
              },
              "parameters": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "size"
                      ]
                    },
                    {
                      "required": [
                        "seconds"
                      ]
                    },
                    {
                      "required": [
                        "fps"
                      ]
                    },
                    {
                      "required": [
                        "strength"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "input": {
                "required": [
                  "prompt"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "text_to_image",
                  "text_to_video",
                  "text_to_audio"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "source_image"
                      ]
                    },
                    {
                      "required": [
                        "mask"
                      ]
                    },
                    {
                      "required": [
                        "references"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "image_to_image"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "required": [
                  "source_image"
                ],
                "not": {
                  "required": [
                    "references"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "references_to_image",
                  "references_to_video"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "required": [
                  "references"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "source_image"
                      ]
                    },
                    {
                      "required": [
                        "mask"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "text_to_image",
                  "image_to_image",
                  "references_to_image"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "seconds"
                      ]
                    },
                    {
                      "required": [
                        "fps"
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "enum": [
                  "text_to_video",
                  "references_to_video"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "properties": {
                  "n": {
                    "const": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "not": {
                  "const": "image_to_image"
                }
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "not": {
                  "required": [
                    "strength"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "references_to_image"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "properties": {
                  "references": {
                    "minItems": 2
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "references_to_video"
              },
              "input": {
                "properties": {
                  "references": {
                    "maxItems": 1
                  }
                },
                "required": [
                  "references"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "properties": {
                  "references": {
                    "items": {
                      "properties": {
                        "role": {
                          "const": "first_frame"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "task_type": {
                "const": "text_to_audio"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "size"
                      ]
                    },
                    {
                      "required": [
                        "fps"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "parameters": {
                "properties": {
                  "seconds": {
                    "maximum": 120
                  }
                }
              }
            }
          }
        }
      ],
      "$defs": {
        "assetId": {
          "type": "string",
          "pattern": "^asset_[A-Za-z0-9_-]{6,80}$"
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_id"
          ],
          "properties": {
            "asset_id": {
              "$ref": "#/$defs/assetId"
            }
          }
        }
      }
    },
    "example_request": {
      "model": "comfy-3080-3d-trellis2",
      "task_type": "image_to_3d",
      "input": {
        "source_image": {
          "asset_id": "asset_REPLACE_WITH_UPLOADED_ID"
        }
      },
      "parameters": {
        "n": 1,
        "quality": "standard",
        "seed": 42
      }
    },
    "output_retention_seconds": 28800,
    "availability_note": "目录表示当前 Key 可发现的已发布能力；设备在线状态、当前容量、额度及提交准入仍需实时检查。"
  }
}
