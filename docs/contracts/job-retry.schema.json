{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://render-control.invalid/contracts/job-retry.schema.json",
  "contract_version": "0.4.0",
  "title": "Evidence-backed internal preparation retry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count",
    "limit",
    "next_at",
    "last_error"
  ],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "limit": {
      "const": 2
    },
    "next_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "last_error": {
      "enum": [
        null,
        "preparation_transport_failure"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "next_at": {
            "type": "null"
          },
          "last_error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "last_error": {
            "const": "preparation_transport_failure"
          }
        }
      }
    }
  ]
}
