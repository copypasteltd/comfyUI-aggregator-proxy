{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:render-control:admin-queue-query:0.4.0",
  "title": "Admin queue query",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[a-f0-9]{32}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-f0-9]{32}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[a-f0-9]{32}$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^wfr_[a-f0-9]{32}$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^ch_[a-f0-9]{32}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^key_[a-f0-9]{32}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "state": {
      "enum": [
        "admission_pending",
        "queued",
        "leased",
        "preparing",
        "submitting",
        "running",
        "collecting",
        "uploading",
        "verifying",
        "reconciling",
        "retry_wait",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "created_from": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "created_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    }
  },
  "additionalProperties": false,
  "$comment": "created_from < created_before is additionally enforced by the query DTO; from inclusive, before exclusive. HTTP integer query values are parsed before validation."
}
