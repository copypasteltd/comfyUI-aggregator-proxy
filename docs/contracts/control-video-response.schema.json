{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://render-control.invalid/contracts/control-video-response.schema.json",
  "title": "Direct control video response with frozen known specifications and scoped native extensions",
  "type": "object",
  "required": [
    "id",
    "object",
    "model",
    "status",
    "job_status",
    "created_at",
    "poll_url",
    "task_type",
    "updated_revision",
    "retry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^job_[a-f0-9]{32}$"
    },
    "object": {
      "const": "video"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "queued",
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "job_status": {
      "enum": [
        "admission_pending",
        "queued",
        "leased",
        "preparing",
        "submitting",
        "running",
        "collecting",
        "uploading",
        "verifying",
        "reconciling",
        "retry_wait",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 253402300799
    },
    "poll_url": {
      "type": "string",
      "pattern": "^/v1/videos/job_[a-f0-9]{32}$"
    },
    "seconds": {
      "description": "Known requested duration, rendered exactly from frozen integer milliseconds; absent for legacy metadata.",
      "type": "string",
      "pattern": "^(?:(?:[1-9][0-9]{0,3}|[1-7][0-9]{4}|8[0-5][0-9]{3}|86[0-3][0-9]{2})(?:\\.[0-9]{1,3})?|86400|0\\.(?:00[1-9]|0[1-9][0-9]?|[1-9][0-9]{0,2}))$"
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]{1,4}x[1-9][0-9]{1,4}$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "generation_failed",
            "task_cancelled",
            "task_expired"
          ]
        },
        "message": {
          "enum": [
            "Generation did not complete",
            "Generation was cancelled",
            "Generation expired"
          ]
        }
      },
      "additionalProperties": false
    },
    "task_type": {
      "enum": [
        "text_to_video",
        "references_to_video"
      ]
    },
    "updated_revision": {
      "type": "integer",
      "minimum": 1
    },
    "completed_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 253402300799
    },
    "retry": {
      "type": "object",
      "required": [
        "count",
        "limit",
        "next_at",
        "last_error"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "limit": {
          "const": 2
        },
        "next_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 253402300799
        },
        "last_error": {
          "enum": [
            null,
            "preparation_transport_failure",
            "comfy_oom"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^content_[a-f0-9]{32}$"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "additionalProperties": false
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "negative_prompt": {
          "type": "string",
          "maxLength": 8000
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "role"
            ],
            "properties": {
              "asset_id": {
                "$ref": "#/$defs/assetId"
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "job_status": {
            "enum": [
              "admission_pending",
              "queued",
              "leased"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "queued"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "enum": [
              "preparing",
              "submitting",
              "running",
              "collecting",
              "uploading",
              "verifying",
              "reconciling",
              "retry_wait",
              "cancel_requested"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "in_progress"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "enum": [
              "failed",
              "cancelled",
              "expired"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "generation_failed"
              },
              "message": {
                "const": "Generation did not complete"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "task_cancelled"
              },
              "message": {
                "const": "Generation was cancelled"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "job_status": {
            "const": "expired"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "task_expired"
              },
              "message": {
                "const": "Generation expired"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "completed_at"
        ]
      },
      "then": {
        "properties": {
          "job_status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "expired"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "assetId": {
      "type": "string",
      "pattern": "^asset_[A-Za-z0-9_-]{6,80}$"
    }
  }
}
