{
  "name": "render-control-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "generate:api": "openapi-typescript ../../config/openapi.json -o src/generated/api.d.ts",
    "test": "vitest run",
    "test:workflow-json": "node --test tests/workflowJson.test.ts",
    "test:gateway-catalog": "node --test tests/gatewayCatalog.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0",
    "vue": "3.5.44",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.0",
    "element-plus": "^2.9.0",
    "@element-plus/icons-vue": "^2.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "openapi-typescript": "^7.6.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0"
  }
}
