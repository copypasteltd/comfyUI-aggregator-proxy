{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generation.local/contracts/admin-workflow-catalog-query.schema.json",
  "title": "admin-workflow-catalog-query",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "q": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
          "not": {
            "pattern": "[\u0000-\u001f-]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^prj_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\r\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "task_type": {
      "anyOf": [
        {
          "enum": [
            "text_to_image",
            "image_to_image",
            "references_to_image",
            "text_to_video",
            "references_to_video",
            "text_to_audio",
            "image_to_3d"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "active",
            "archived"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wf_[a-f0-9]{32}$",
          "not": {
            "pattern": "[\r\n]"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": []
}
