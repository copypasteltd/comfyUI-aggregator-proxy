{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generation.local/contracts/admin-workflow-catalog-page.schema.json",
  "title": "admin-workflow-catalog-page",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wf_[a-f0-9]{32}$",
            "not": {
              "pattern": "[\r\n]"
            }
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^ten_[a-f0-9]{32}$",
            "not": {
              "pattern": "[\r\n]"
            }
          },
          "project_id": {
            "type": "string",
            "pattern": "^prj_[a-f0-9]{32}$",
            "not": {
              "pattern": "[\r\n]"
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "task_type": {
            "enum": [
              "text_to_image",
              "image_to_image",
              "references_to_image",
              "text_to_video",
              "references_to_video",
              "text_to_audio"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "archived": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "tenant_id",
          "project_id",
          "name",
          "task_type",
          "revision",
          "archived",
          "created_at"
        ]
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "has_more": {
      "type": "boolean"
    },
    "snapshot_at": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\\x00-\\x1f\\x7f-\\x9f])?$",
              "not": {
                "pattern": "[\u0000-\u001f-]"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^prj_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\r\n]"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "task_type": {
          "anyOf": [
            {
              "enum": [
                "text_to_image",
                "image_to_image",
                "references_to_image",
                "text_to_video",
                "references_to_video",
                "text_to_audio"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "active",
                "archived"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^wf_[a-f0-9]{32}$",
              "not": {
                "pattern": "[\r\n]"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "data",
    "page",
    "has_more",
    "snapshot_at",
    "total",
    "filters"
  ]
}
