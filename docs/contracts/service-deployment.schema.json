{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:render-control:service-deployment:0.5.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "deployment_id", "installation", "services"],
  "properties": {
    "protocol": {"const": "native-services-v1"},
    "deployment_id": {"$ref": "#/$defs/name"},
    "installation": {"$ref": "#/$defs/path"},
    "services": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/service"}}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?$"},
    "path": {"type": "string", "minLength": 4, "maxLength": 240, "pattern": "^[A-Za-z]:[/\\\\][^%\"<>|?*\\u0000-\\u001f\\u007f:]+$"},
    "listen": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "port", "tls_cert", "tls_key", "allow_network_bind"],
      "properties": {
        "host": {"type": "string", "minLength": 2, "maxLength": 45},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tls_cert": {"$ref": "#/$defs/path"}, "tls_key": {"$ref": "#/$defs/path"},
        "allow_network_bind": {"type": "boolean"}
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "instance", "config", "state_dir", "startup"],
      "properties": {
        "role": {"enum": ["api", "runner", "gc", "worker", "gateway"]},
        "instance": {"$ref": "#/$defs/name"}, "config": {"$ref": "#/$defs/path"}, "state_dir": {"$ref": "#/$defs/path"},
        "startup": {"enum": ["manual", "automatic-delayed"]},
        "listen": {"$ref": "#/$defs/listen"}, "native_config": {"$ref": "#/$defs/path"}
      },
      "allOf": [
        {"if": {"properties": {"role": {"const": "api"}}}, "then": {"required": ["listen"]}, "else": {"not": {"required": ["listen"]}}},
        {"if": {"properties": {"role": {"const": "gateway"}}}, "then": {"required": ["native_config"]}, "else": {"not": {"required": ["native_config"]}}}
      ]
    }
  }
}
