  "http_rejection_classes": [
    "identity",
    "permission",
    "quota",
    "capacity",
    "conflict",
    "validation",
    "internal",
    "other"
  ],
  "snapshot_cache_seconds": 5,
  "snapshot_sql_budget_seconds": 2,
  "snapshot_statement_budget_seconds": 1,
  "capacity_nodes_limit": 256,
  "capacity_json_bytes_limit": 8192,
  "exposition_bytes_limit": 2097152,
  "recent_window_seconds": 3600,
  "dependency": "prometheus-client==0.26.0"
